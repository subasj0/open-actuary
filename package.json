{
  "name": "open-actuary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/tests/learning.test.mjs",
    "preview": "wrangler dev --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.0",
    "katex": "0.19.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.27.4",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.154.0"
  }
}
