{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"open-actuary",
 "main":"dist/worker.js",
 "compatibility_date":"2026-10-28",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "assets":{"directory":"dist/public","binding":"ASSETS","run_worker_first":["/api/*","/mcp","/oauth/*","/.well-known/*"],"not_found_handling":"single-page-application"},
 "d1_databases":[{"binding":"DB","database_name":"open-actuary","database_id":"90640bbd-b1e4-4d18-85ee-8d979bf4dc36","migrations_dir":"migrations"}],
 "triggers":{"crons":["23 3 * * *"]},
 "observability":{"enabled":true,"head_sampling_rate":0.1}
}
